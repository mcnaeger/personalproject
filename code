    if pd.to_datetime(start_date) > pd.to_datetime(end_date):
        print("Error: Start date must be before end date.")
    else:
        stock_data = filter_data(data, stock_symbol, start_date, end_date)
        stock_data = moving_averages(stock_data)
        stock_data, volatility = daily_returns_volatility(stock_data)

        print(f"\nAnalysis for {stock_symbol}:")
        print(f"Volatility (Standard Deviation of Daily Returns): {volatility:.4f}")

        plot_stock(stock_data, stock_symbol)
